# ==============================================================================
# RiskVision.ai Git Ignore Rules
# ==============================================================================

# Node / Frontend Build & Dependencies
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (Keep .env.example templates)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Firebase & Cloud Service Account Credentials
*firebase-adminsdk*.json
*service-account*.json
firebase-credentials.json
eyeview-v2-firebase-adminsdk-fbsvc-a1600b8e74.json

# Local User Data, Incident Logs & Recovery Codes
users.json
Backend/users.json
alert_log*.json
Backend/alert_log*.json
*twilio_2FA_recovery_code*.txt
Backend/twilio_2FA_recovery_code.txt

# Python Virtual Environments
venv/
ENV/
env/
Backend/venv/
.venv/

# Python Runtime, Caches & Bytecode
__pycache__/
Backend/__pycache__/
*.py[cod]
*$py.class
Backend/runs/
runs/

# Security Keys & Certificates
*.pem
*.key
*.crt
*.pfx

# Generated Video Clips, Thumbnails & Encoding Frames
static/history_clips/*
!static/history_clips/.gitkeep
Backend/static/history_clips/*
!Backend/static/history_clips/.gitkeep
temp_frames_*
Backend/temp_frames_*

# Unused Model Checkpoints (best.pt 15MB is retained for production)
Backend/last.pt
Backend/yolo11n.pt
Backend/templates/
templates/yolo11n.pt

# Machine-Specific / Legacy Script Artifacts & Scratch Files
Backend/riskvision-MSI.py
Backend/args.yaml
Backend/results.csv
project.md

# Editor & System Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.backup

# External Tool Worktree Pointers
.kilo/
