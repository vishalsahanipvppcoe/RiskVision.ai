# ==============================================================================
# RiskVision.ai Backend Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' in the Backend directory:
#    cp .env.example .env
# 2. Fill in your environment-specific values below.
# 3. NEVER commit your actual '.env' file or service account credentials to Git.
# ==============================================================================

# --- Server Configuration ---
# Environment mode: 'development' or 'production'
FLASK_ENV=development
# Set to 'False' in production (prevents debug pin & interactive debugger exposure)
FLASK_DEBUG=False
# Bind host ('0.0.0.0' to accept external traffic, '127.0.0.1' for local only)
HOST=0.0.0.0
# Listening port (Render/Railway sets PORT dynamically)
PORT=5000

# --- JWT Authentication & Security ---
# REQUIRED: Cryptographic secret key used to sign JWT tokens.
# Production MUST define this variable. The backend refuses to start without it in production mode.
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_byte_key
# Token expiration time in hours (default: 24)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins that can interact with the API.
# Includes local dev servers and deployed Vercel domain:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://risk-vision-ai-rho.vercel.app

# --- Firebase Realtime Database & Admin SDK Configuration ---
# You can authenticate Firebase Admin SDK using EITHER Option A OR Option B:
#
# Option A (Local Development / Persistent Volumes):
# Relative or absolute file path to your service account JSON file.
# Note: Keep the JSON file outside Git (covered by .gitignore).
FIREBASE_CREDENTIALS_PATH=riskvision-ai-firebase-adminsdk.json
#
# Option B (Production Cloud Containers e.g. Render, Railway, AWS ECS):
# Supply the raw service account JSON string directly as an environment variable
# so no credentials file needs to be mounted or stored on disk.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key":"<YOUR_SERVICE_ACCOUNT_PRIVATE_KEY>"}
#
# REQUIRED: URL of your Firebase Realtime Database instance
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# --- Computer Vision & Video Processing ---
# Video source index or stream URL:
# - '0' for default webcam (local development)
# - RTSP stream URL (e.g., rtsp://user:pass@ip:port/h264)
# - Path to a test video file for headless/cloud testing
VIDEO_SOURCE=0
# Path to ffmpeg binary (uses system PATH by default; specify full path if needed)
FFMPEG_PATH=ffmpeg
# Optional custom path for model weights (default: best.pt in Backend directory)
# MODEL_PATH=best.pt

# --- Twilio SMS Alerts (Optional) ---
# If credentials are not set, SMS notifications are safely skipped without errors.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE_NUMBER=
