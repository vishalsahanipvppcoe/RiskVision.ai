# ==============================================================================
# RiskVision.ai Frontend Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' in the RiskVision-frontend directory:
#    cp .env.example .env
# 2. Adjust VITE_API_URL to point to your running RiskVision backend API.
# Note: Vite only exposes variables prefixed with VITE_ to client-side code.
# NEVER put private server credentials or private keys in frontend env files!
# ==============================================================================

# Backend API Base URL
# - Local development on Windows: http://localhost:5000
# - Production deployment on Vercel connecting to local PC host via secure HTTPS tunnel (e.g. Cloudflare Tunnel / ngrok):
#   VITE_API_URL=https://your-host-tunnel.trycloudflare.com
VITE_API_URL=http://localhost:5000
